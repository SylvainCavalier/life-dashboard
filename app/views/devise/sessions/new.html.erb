<h1>Life Dashboard</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="field">
    <%= f.label :email, "Adresse email" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "username", required: true %>
  </div>

  <div class="field">
    <%= f.label :password, "Mot de passe" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true %>
  </div>

  <div class="check">
    <%= f.check_box :remember_me %>
    <%= f.label :remember_me, "Rester connecte" %>
  </div>

  <%= f.submit "Se connecter", class: "btn" %>
<% end %>
