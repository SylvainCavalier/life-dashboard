<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Connexion</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
    <meta name="referrer" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: #f9fafb;
        color: #111827;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .08), 0 8px 24px rgba(0, 0, 0, .04);
        padding: 40px;
        width: 100%;
        max-width: 400px;
      }
      h1 { font-size: 20px; font-weight: 600; margin: 0 0 28px; text-align: center; }
      label { display: block; font-size: 13px; font-weight: 500; color: #374151; margin-bottom: 6px; }
      .field { margin-bottom: 18px; }
      input[type="email"], input[type="password"] {
        width: 100%;
        font-size: 15px;
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #fff;
        color: #111827;
      }
      input[type="email"]:focus, input[type="password"]:focus {
        outline: none;
        border-color: #111827;
        box-shadow: 0 0 0 3px rgba(17, 24, 39, .08);
      }
      .check { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; }
      .check label { margin: 0; font-weight: 400; color: #6b7280; }
      .btn {
        width: 100%;
        background: #111827;
        color: #fff;
        border: 0;
        font-size: 15px;
        font-weight: 500;
        padding: 12px;
        border-radius: 10px;
        cursor: pointer;
        transition: background .15s ease;
      }
      .btn:hover { background: #374151; }
      .flash {
        font-size: 14px;
        padding: 10px 14px;
        border-radius: 10px;
        margin-bottom: 20px;
        line-height: 1.5;
      }
      .flash-alert { background: #fef2f2; color: #991b1b; }
      .hint { font-size: 12px; color: #9ca3af; margin: 6px 0 0; }
      .intro { font-size: 14px; color: #6b7280; line-height: 1.6; margin: -12px 0 24px; }
      .back { text-align: center; margin: 24px 0 0; font-size: 13px; }
      .back a { color: #6b7280; text-decoration: none; }
      .back a:hover { color: #111827; }
      .flash-notice { background: #f0fdf4; color: #166534; }
    </style>
  </head>

  <body>
    <main class="card">
      <% if alert.present? %>
        <p class="flash flash-alert"><%= alert %></p>
      <% end %>
      <% if notice.present? %>
        <p class="flash flash-notice"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
