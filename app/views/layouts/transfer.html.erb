<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Telechargement" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex">
    <meta name="referrer" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: #f9fafb;
        color: #111827;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      .card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .08), 0 8px 24px rgba(0, 0, 0, .04);
        padding: 40px;
        width: 100%;
        max-width: 460px;
        text-align: center;
      }
      .icon { font-size: 44px; line-height: 1; margin-bottom: 20px; }
      h1 {
        font-size: 20px;
        font-weight: 600;
        margin: 0 0 8px;
        word-break: break-word;
      }
      .meta { font-size: 14px; color: #6b7280; margin: 0 0 28px; }
      .btn {
        display: inline-block;
        background: #111827;
        color: #fff;
        text-decoration: none;
        font-size: 15px;
        font-weight: 500;
        padding: 12px 32px;
        border-radius: 10px;
        transition: background .15s ease;
      }
      .btn:hover { background: #374151; }
      .footer { font-size: 12px; color: #9ca3af; margin: 28px 0 0; }
      .muted { color: #6b7280; font-size: 15px; margin: 0; line-height: 1.6; }
    </style>
  </head>

  <body>
    <main class="card">
      <%= yield %>
    </main>
  </body>
</html>
